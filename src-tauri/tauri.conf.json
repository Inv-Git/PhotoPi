{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoPi",
  "version": "1.1.0",
  "identifier": "fr.clem.photopi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PhotoPi",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Clem",
    "copyright": "© 2026 Clem",
    "category": "Photography",
    "shortDescription": "Visionneuse de photothèque",
    "longDescription": "PhotoPi, visionneuse pour photothèques rangées par année et par mois : chronologie, photos RAW, vidéos et photos animées, revue des doublons.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "PhotoPi"
      }
    }
  }
}
